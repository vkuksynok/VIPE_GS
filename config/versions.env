# RunPod base. The image tag is pinned; record its resolved digest in the
# environment report after the pod is created.
RUNPOD_TEMPLATE_ID="runpod-torch-v280"
RUNPOD_IMAGE="runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404"
RUNPOD_DATA_CENTER_ID="EU-RO-1"
# Your own network volume id, reported by verify_environment.sh for comparison.
RUNPOD_NETWORK_VOLUME_ID="${RUNPOD_NETWORK_VOLUME_ID:-}"

# Conda distribution used to build VIPE's native/CUDA environment. The RunPod
# PyTorch image ships no conda, so setup_vipe.sh installs this release onto the
# network volume.
MINIFORGE_VERSION="26.7.2-0"

# NVIDIA VIPE. This commit is the verified main head from 2026-09-10 and reports
# project version 1.2.0. Its upstream uv.lock is used with `uv sync --frozen`.
VIPE_REPOSITORY="https://github.com/nv-tlabs/vipe.git"
VIPE_COMMIT="8c9f36144e08d8f8c8cf60d20ad70c100d9cff07"
VIPE_VERSION="1.2.0"
VIPE_PYTHON_VERSION="3.12"
VIPE_CUDA_VERSION="12.8"

# Nerfstudio release and its documented compatible CUDA stack.
NERFSTUDIO_REPOSITORY="https://github.com/nerfstudio-project/nerfstudio.git"
NERFSTUDIO_COMMIT="6b60855003011b2ca23c2fe3f8e2ca6314c69924"
NERFSTUDIO_VERSION="1.1.5"
# Raised together for Blackwell (sm_120): the documented torch 2.1.2/CUDA 11.8
# stack only builds up to sm_90, and torch 2.9.0+cu128 publishes no cp310 wheel.
# Nerfstudio 1.1.5 only caps torch below 2.2 in its dev extra, not at runtime,
# and still pins gsplat 1.4.0, which ships pure Python and compiles its kernels
# for the local architecture.
NERFSTUDIO_PYTHON_VERSION="3.12"
NERFSTUDIO_CUDA_VERSION="12.8"
PYTORCH_VERSION="2.9.0+cu128"
TORCHVISION_VERSION="0.24.0+cu128"
GSPLAT_VERSION="1.4.0"
NUMPY_VERSION="2.5.3"

# Pipeline defaults. Override paths in config/paths.env and run parameters via
# environment variables without modifying the version manifest. These use the
# :- form so an exported value wins; the version pins above deliberately do not.
DATASET_EXPECTED_FRAMES="${DATASET_EXPECTED_FRAMES:-126}"
DATASET_FPS="${DATASET_FPS:-1}"
DATASET_MAX_WIDTH="${DATASET_MAX_WIDTH:-1920}"
SPLATFACTO_MAX_ITERATIONS="${SPLATFACTO_MAX_ITERATIONS:-30000}"
SPLATFACTO_DOWNSCALE_FACTOR="${SPLATFACTO_DOWNSCALE_FACTOR:-1}"
SPLATFACTO_EVAL_INTERVAL="${SPLATFACTO_EVAL_INTERVAL:-8}"
PIPELINE_SEED="${PIPELINE_SEED:-42}"
