# Copy this file to config/paths.env only when a machine needs overrides.
# Every value may also be supplied as an environment variable.
WORKSPACE_ROOT="${GS_WORKSPACE_ROOT:-/workspace/gs_test}"

DATA_ROOT="${DATA_ROOT:-${WORKSPACE_ROOT}/data}"
# Where the source archives were uploaded on the volume.
RAW_DATASET="${RAW_DATASET:-/workspace/datasets/Zavod70_small.zip}"
RAW_DATASET_FULL="${RAW_DATASET_FULL:-/workspace/datasets/zavod70.zip}"
RAW_FRAME_DIR="${RAW_FRAME_DIR:-${DATA_ROOT}/raw/Zavod70_small}"
PREPARED_DATASET_DIR="${PREPARED_DATASET_DIR:-${DATA_ROOT}/prepared/zavod70}"
INPUT_VIDEO="${INPUT_VIDEO:-${PREPARED_DATASET_DIR}/zavod70.mp4}"

THIRD_PARTY_ROOT="${THIRD_PARTY_ROOT:-${WORKSPACE_ROOT}/third_party}"
VIPE_SOURCE_DIR="${VIPE_SOURCE_DIR:-${THIRD_PARTY_ROOT}/vipe}"
NERFSTUDIO_SOURCE_DIR="${NERFSTUDIO_SOURCE_DIR:-${THIRD_PARTY_ROOT}/nerfstudio}"

ENV_ROOT="${ENV_ROOT:-${WORKSPACE_ROOT}/envs}"
CONDA_ROOT="${CONDA_ROOT:-${ENV_ROOT}/miniforge}"
VIPE_CONDA_PREFIX="${VIPE_CONDA_PREFIX:-${ENV_ROOT}/vipe-cu128}"
VIPE_UV_ENVIRONMENT="${VIPE_UV_ENVIRONMENT:-${ENV_ROOT}/vipe-python}"
NERFSTUDIO_CONDA_PREFIX="${NERFSTUDIO_CONDA_PREFIX:-${ENV_ROOT}/nerfstudio}"

CACHE_ROOT="${CACHE_ROOT:-${WORKSPACE_ROOT}/cache}"
HF_HOME="${HF_HOME:-${CACHE_ROOT}/huggingface}"
# VIPE pulls Video-Depth-Anything through torch.hub, which defaults to the
# container disk and would be lost on pod restart.
TORCH_HOME="${TORCH_HOME:-${CACHE_ROOT}/torch}"
UV_CACHE_DIR="${UV_CACHE_DIR:-${CACHE_ROOT}/uv}"
UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-${CACHE_ROOT}/uv-python}"
PIP_CACHE_DIR="${PIP_CACHE_DIR:-${CACHE_ROOT}/pip}"
TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-${CACHE_ROOT}/torch_extensions}"

RUNS_ROOT="${RUNS_ROOT:-${WORKSPACE_ROOT}/outputs}"
VIPE_OUTPUT_DIR="${VIPE_OUTPUT_DIR:-${RUNS_ROOT}/vipe}"
VIPE_SEQUENCE="${VIPE_SEQUENCE:-zavod70}"
COLMAP_RAW_DIR="${COLMAP_RAW_DIR:-${RUNS_ROOT}/colmap_raw}"
SPLAT_DATASET_DIR="${SPLAT_DATASET_DIR:-${DATA_ROOT}/splatfacto/zavod70}"
SPLAT_OUTPUT_DIR="${SPLAT_OUTPUT_DIR:-${RUNS_ROOT}/splatfacto}"

ARTIFACT_ROOT="${ARTIFACT_ROOT:-${WORKSPACE_ROOT}/artifacts}"
ENV_REPORT_DIR="${ENV_REPORT_DIR:-${ARTIFACT_ROOT}/environment}"
EXPORT_DIR="${EXPORT_DIR:-${WORKSPACE_ROOT}/exports/zavod70}"
RENDER_DIR="${RENDER_DIR:-${WORKSPACE_ROOT}/renders}"
LOG_DIR="${LOG_DIR:-${WORKSPACE_ROOT}/logs}"

# Set after training if automatic discovery is ambiguous.
SPLAT_CONFIG="${SPLAT_CONFIG:-}"
